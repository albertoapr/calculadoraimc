{
  "name": "calculadora-imc-beta",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "test:whatsapp": "node --test tests/whatsapp-login.test.cjs",
    "test:selection": "node --import tsx --test tests/trainer-selection.test.ts",
    "lint": "eslint src",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "test": "npm run test:whatsapp && node --import tsx --test tests/*.test.ts",
    "test:browser": "node scripts/frontend-smoke.cjs",
    "check": "npm run lint && npm run format:check && npm run build && npm test"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.933.0",
    "google-auth-library": "^9.15.1",
    "nodemailer": "^10.3.1",
    "pinia": "3.0.4",
    "vue": "^3.4.21",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.5.0",
    "@aws-amplify/backend-cli": "^1.2.9",
    "@eslint/js": "^9.39.5",
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^20.12.5",
    "@types/nodemailer": "^8.0.2",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/tsconfig": "^0.5.1",
    "aws-cdk": "^2.137.0",
    "aws-cdk-lib": "^2.137.0",
    "constructs": "^10.3.0",
    "esbuild": "^0.20.2",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.12.1",
    "jsdom": "^26.1.0",
    "npm-run-all2": "^6.1.2",
    "playwright": "^1.65.0",
    "prettier": "^3.10.1",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.72.2",
    "vite": "^5.4.10",
    "vue-tsc": "^2.0.11"
  }
}
